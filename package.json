{
  "name": "breeze-hc",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src cms workers/cms/src next.config.mjs",
    "cms:check": "npm --prefix workers/cms run typecheck && npm --prefix workers/cms test",
    "cms:proof": "node workers/cms/tests/local-proof.mjs",
    "cms:preview-proof": "node --env-file=.local/cms-preview.env --env-file=.env.local workers/cms/tests/preview-proof.mjs",
    "cms:preview-workflow": "node --env-file=.local/cms-preview.env --env-file=.env.local workers/cms/tests/preview-proof.mjs --allow-test-writes"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-document": "3.32.0",
    "@tiptap/extension-hard-break": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-text": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@vercel/oidc": "4.0.0",
    "next": "16.3.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "10.12.0",
    "jsdom": "26.1.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.71.2"
  }
}
