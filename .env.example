# Test editor only: leave false on production. Never use NEXT_PUBLIC_ for these values.
CMS_TEST_ENABLED=false
# Optional proof tools for local/Preview only. Keep disabled for normal editing.
CMS_PROOF_ENABLED=false
CMS_TEST_ORIGIN=http://localhost:3000
CMS_WORKER_URL=http://127.0.0.1:8787
# Email-code login. Generate a DIFFERENT 64-hex-character secret per environment.
CMS_AUTH_SECRET=
# Resend Sending access key for nikodola.com. Keep this server-side only.
RESEND_API_KEY=
# Published Resend template ID or alias. Its CODE variable must have String type.
# Defaults to admin-verification-code if omitted. Template owns subject/content.
RESEND_LOGIN_TEMPLATE_ID=admin-verification-code
# Sender is fixed in code to verification@nikodola.com.
# Generate separate random values of at least 32 characters for the tokens below.
CMS_WRITE_TOKEN=
# Next-to-Next cache authentication only; never configure this in the Worker.
CMS_REVALIDATE_SECRET=

# Explicit client launch: Production + main + the exact client origin only.
# Configure these in Vercel Production, with independent auth secrets and the
# live Worker URL. Leave CMS_TEST_ENABLED false there; never reuse Preview secrets.
CMS_LIVE_ENABLED=false
CMS_LIVE_ORIGIN=https://breeze-full.vercel.app
# CMS_TEST_USERNAME/PASSWORD and CMS_LIVE_USERNAME/PASSWORD are retired.

# Clarity runs only on Vercel Production after visitor consent.
# Set false and redeploy to disable analytics.
CLARITY_ENABLED=true
