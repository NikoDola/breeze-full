{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breeze-test-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "CMS_ENVIRONMENT": "test",
    "CMS_WRITES_ENABLED": "false",
    "CMS_UPLOAD_ORIGIN": "https://breeze-full-git-cms-testing-nikodolas-projects.vercel.app"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "2026101401", "simple": { "limit": 120, "period": 60 } },
    { "name": "SERVICE_RATE_LIMITER", "namespace_id": "2026101402", "simple": { "limit": 600, "period": 60 } }
  ],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "breeze-test-db",
    "database_id": "bc8cb3a4-bf92-4be6-82d0-84738ec3a381",
    "migrations_dir": "migrations",
    "migrations_table": "cms_schema_migrations"
  }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "breeze-test-assets" }],
  "triggers": { "crons": [] }
}
