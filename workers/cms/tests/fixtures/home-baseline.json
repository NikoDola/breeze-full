{
  "sourceCommit": "5b40373fc78403c689d82550d9ca7067e2f97bdd",
  "sections": {
    "SeasonsSection": "<section class=\"section seasons\" id=\"heating-cooling\" aria-labelledby=\"seasons-title\"><div class=\"wrap\"><div class=\"section-heading\"><div><h2 id=\"seasons-title\">A good day starts<br/>at the <em>right temperature.</em></h2></div><p>Whatever Tennessee weather has planned, we have your comfort covered.</p></div><div class=\"season-grid\"><article class=\"season-card cooling\"><div class=\"season-top\"><span class=\"season-icon\" aria-hidden=\"true\">❄</span></div><h3>Keep your cool.</h3><p class=\"season-label\">Cooling</p><p>Our expert technicians work to cool your TN home efficiently and affordably with high-quality Middle Tennessee cooling systems, maintenance and emergency repairs. Trust us with your comfort.</p><a href=\"#contact\" data-service=\"Cooling\">Request cooling service <span aria-hidden=\"true\">↗</span></a></article><article class=\"season-card heating\"><div class=\"season-top\"><span class=\"season-icon\" aria-hidden=\"true\">☀</span></div><h3>Bring on cozy.</h3><p class=\"season-label\">Heating</p><p>From new installations and retrofits to emergency repairs and maintenance, Breeze delivers award-winning Middle Tennessee heating services to TN customers. Your satisfaction is our priority.</p><a href=\"#contact\" data-service=\"Heating\">Request heating service <span aria-hidden=\"true\">↗</span></a></article></div></div></section>",
    "ContactSection": "<section class=\"section contact\" id=\"contact\" aria-labelledby=\"contact-title\"><div class=\"wrap contact-grid\"><div class=\"contact-copy\"><h2 id=\"contact-title\">Let&#x27;s make home feel <em>just right.</em></h2><p>Tell us what you need. We&#x27;ll help you take the next step.</p><div class=\"contact-doodle\" aria-hidden=\"true\">☺</div><a class=\"contact-phone\" href=\"tel:+16155239898\"><span>Want to talk now?</span><strong><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6.5 3h3l1.5 5-2 1.5a12 12 0 0 0 5 5l1.5-2 5 1.5v3a2 2 0 0 1-2 2A17 17 0 0 1 4.5 5a2 2 0 0 1 2-2Z\"></path></svg>615-523-9898 ↗</strong></a></div><form class=\"contact-form\" id=\"service-form\"><h3>Request service</h3><p class=\"form-intro\">A few details and we’ll be on our way.</p><div class=\"form-grid\"><div class=\"field\"><label for=\"name\">Your name <span>*</span></label><input class=\"ui-input\" id=\"name\" type=\"text\" autoComplete=\"name\" placeholder=\"Jane Smith\" required=\"\" name=\"name\"/></div><div class=\"field\"><label for=\"phone\">Phone number <span>*</span></label><input class=\"ui-input\" id=\"phone\" type=\"tel\" autoComplete=\"tel\" placeholder=\"(615) 555-0100\" required=\"\" name=\"phone\"/></div><div class=\"field\"><label for=\"email\">Email address <span>*</span></label><input class=\"ui-input\" id=\"email\" type=\"email\" autoComplete=\"email\" placeholder=\"jane@example.com\" required=\"\" name=\"email\"/></div><div class=\"field\"><label for=\"service\">Service needed <span>*</span></label><select class=\"ui-select\" id=\"service\" name=\"service\" required=\"\"><option value=\"\" disabled=\"\" selected=\"\">Select a service</option><option value=\"Heating\">Heating</option><option value=\"Cooling\">Cooling</option><option value=\"Repairs &amp; Services\">Repairs &amp; Services</option><option value=\"Indoor quality\">Indoor quality</option><option value=\"Water heater solutions\">Water heater solutions</option><option value=\"Mini-split systems\">Mini-split systems</option><option value=\"Energy audits\">Energy audits</option><option value=\"Commercial &amp; Industrial\">Commercial &amp; Industrial</option><option value=\"Residential\">Residential</option><option value=\"Property manager\">Property manager</option><option value=\"Comfort club\">Comfort club</option><option value=\"Financing\">Financing</option><option value=\"Wi-Fi and Learning Thermostats\">Wi-Fi and Learning Thermostats</option><option value=\"Emergency service\">Emergency service</option><option value=\"Other\">Other</option></select></div><div class=\"field field-wide\"><label for=\"message\">Tell us more <small>(optional)</small></label><textarea class=\"ui-textarea\" id=\"message\" name=\"message\" rows=\"4\" placeholder=\"What is going on with your system?\"></textarea></div></div><div class=\"sms-consent\"><input class=\"ui-input\" id=\"sms-consent\" type=\"checkbox\" name=\"sms_consent\" value=\"yes\"/><label for=\"sms-consent\">Yes, Breeze Heating &amp; Cooling may text me at the phone number above about my service request and appointment updates. This is optional. Message and data rates may apply. Reply STOP to opt out.</label></div><button class=\"ui-button button orange submit-button\" type=\"submit\">Prepare service request <span aria-hidden=\"true\">↗</span></button><p class=\"form-note\">Your email app will open with the request ready to send. See our <a href=\"/privacy-policy\">Privacy Policy</a>.</p></form></div></section>",
    "ReviewsSection": "<section class=\"section reviews\" id=\"reviews\" aria-labelledby=\"reviews-title\"><div class=\"wrap\"><div class=\"section-heading reviews-heading\"><div><h2 id=\"reviews-title\">Good words from<br/><em>good neighbors.</em></h2></div><p>Kind words from people we&#x27;ve helped across Middle Tennessee.</p></div><div class=\"review-grid\"><figure class=\"review-card\"><span class=\"review-stars\" aria-label=\"Five stars\">★★★★★</span><blockquote>“The whole team at Breeze was very considerate and helpful while putting in our system. Wish there were more companies like this one.”</blockquote><figcaption>David and Deborah Marks</figcaption></figure><figure class=\"review-card\"><span class=\"review-stars\" aria-label=\"Five stars\">★★★★★</span><blockquote>“All of your personnel seem knowledgeable about their jobs. The entire crew was awesome!”</blockquote><figcaption>Nancy Fessler</figcaption></figure><figure class=\"review-card\"><span class=\"review-stars\" aria-label=\"Five stars\">★★★★★</span><blockquote>“We have been using Breeze for 3 years and will not use anyone else. Kam is sweet, kind, and very professional. He always comes through for us.”</blockquote><figcaption>Lana Pargh</figcaption></figure></div></div></section>",
    "AreaSection": "<section class=\"section map-section\" id=\"area\" aria-labelledby=\"area-title\"><div class=\"wrap map-grid\"><div class=\"map-copy\"><h2 id=\"area-title\">Made for Middle <em>Tennessee.</em></h2><p>From Nashville to Brentwood and the communities around them, friendly comfort care is close to home.</p><a class=\"text-link\" href=\"https://www.google.com/maps/search/?api=1&amp;query=7175%20Nolensville%20Road%2C%20Nolensville%2C%20TN%2037135\" target=\"_blank\" rel=\"noopener noreferrer\">Explore Nashville on Google Maps <span aria-hidden=\"true\">↗</span></a></div><div class=\"map-frame\"><iframe title=\"Google Map of Nashville, Tennessee\" src=\"https://www.google.com/maps?q=Nashville%2C%20TN&amp;output=embed\" loading=\"lazy\" referrerPolicy=\"no-referrer-when-downgrade\" allowFullScreen=\"\"></iframe></div></div></section>"
  },
