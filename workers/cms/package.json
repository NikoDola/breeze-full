{
  "name": "breeze-cms-test-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "inspect:local": "wrangler d1 execute DB --local --file sql/inspect.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
